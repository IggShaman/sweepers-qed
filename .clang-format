# .clang-format
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
BreakBeforeBraces: Allman
PointerAlignment: Left
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline   # keeps `size_t rows() const { return rows_; }`
UseTab: Never                              # your files mix tabs/spaces; this settles it

AlignAfterOpenBracket: AlwaysBreak          # break after '(' instead of aligning to it
BinPackArguments: false                     # one argument per line
BinPackParameters: false                    # same for declarations/definitions
AllowAllArgumentsOnNextLine: false          # don't collapse them onto one wrapped line
AllowAllParametersOfDeclarationOnNextLine: false
ContinuationIndentWidth: 2                  # the '2' in your spec
InsertBraces: true            # always brace single-statement bodies
